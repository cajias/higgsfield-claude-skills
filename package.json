{
  "name": "higgsfield-claude-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Higgsfield AI plugin marketplace for Claude Code — tooling for docs/markdown/commits.",
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/node_modules/**\" --ignore \"plugins/**/skills/**/SKILL.md\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/node_modules/**\" --ignore \"plugins/**/skills/**/SKILL.md\" --fix",
    "format": "prettier --write \"**/*.{json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{json,md}\" --ignore-path .prettierignore",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.46.0",
    "prettier": "^3.7.1"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ]
  }
}
